# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Without these the site runs on the bundled JSON in src/data and images in /public.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Only needed for `npm run seed` (uploads assets + content). Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
