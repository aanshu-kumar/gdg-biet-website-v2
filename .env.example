# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Without these the site runs on the bundled JSON in src/data and images in /public.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Only needed for `npm run seed` (uploads assets + content). Never add this to Vercel.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
